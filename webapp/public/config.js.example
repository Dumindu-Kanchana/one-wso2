// Template for public/config.js — copy to public/config.js and fill values.
// This file is loaded at runtime by index.html BEFORE the React bundle, so
// every environment can serve the same static bundle with different config.
// Never commit the filled-in config.js (see .gitignore).
window.config = {
  // Asgardeo OAuth
  ONE_WSO2_AUTH_BASE_URL: "https://api.asgardeo.io/t/<your-org>",
  ONE_WSO2_AUTH_CLIENT_ID: "<your-client-id>",
  ONE_WSO2_AUTH_SIGN_IN_REDIRECT_URL: "http://localhost:3000",
  ONE_WSO2_AUTH_SIGN_OUT_REDIRECT_URL: "http://localhost:3000",
  // Optional override — only needed for non-standard Asgardeo deployments.
  // Defaults to the ONE_WSO2_AUTH_BASE_URL with the api. subdomain swapped
  // for myaccount. (Asgardeo Cloud convention).
  // ONE_WSO2_ASGARDEO_MYACCOUNT_URL: "https://myaccount.asgardeo.io/t/<your-org>",

  // UI
  ONE_WSO2_THEME: "acrylicOrange",

  // people-ops-suite people-app backend base URL. Same value as people-app's
  // REACT_APP_BACKEND_BASE_URL — usually a Choreo API gateway URL. Powers
  // the live My profile page (employee + personal info fetch).
  ONE_WSO2_PEOPLE_BACKEND_URL: "<your-people-app-backend-url>",

  // digiops-hr promotion-app backend base URL. Optional — when absent, the
  // Performance & growth card's "Last promoted date" row shows a
  // "not configured" state. Same Choreo API gateway URL pattern as
  // people-app.
  // ONE_WSO2_PROMOTION_BACKEND_URL: "<your-promotion-app-backend-url>",

  // digiops-hr par-app backend base URL. Optional — when absent, the
  // Performance & growth card's active-review row shows a
  // "not configured" state. Same Choreo API gateway URL pattern.
  // ONE_WSO2_PAR_BACKEND_URL: "<your-par-app-backend-url>",

  // digiops-hr banking-app backend base URL. Optional — when absent, the
  // Bank accounts card shows a "not configured" state. Same Choreo API
  // gateway URL pattern; unlike par/promotion apps, this one does NOT
  // require the x-user-timezone-offset header.
  // ONE_WSO2_BANKING_BACKEND_URL: "<your-banking-app-backend-url>",

  // people-ops-suite leave-app backend base URL. Optional — when absent,
  // the People Ops → Leave screens (Apply / Approve / My History /
  // Reports) show a "not configured" state. Same Choreo API gateway URL
  // pattern; leave-app has its own /user-info + privileges.
  // ONE_WSO2_LEAVE_BACKEND_URL: "<your-leave-app-backend-url>",

  // digiops-finance backend base URLs — the three apps in the Finance
  // perspective. Each is a separate Ballerina service with its own
  // /user-info + role scheme. Optional — when a URL is absent, that app's
  // screens show a "not connected" state. Same Choreo API gateway URL
  // pattern as the other backends.
  // ONE_WSO2_OPD_BACKEND_URL: "<your-opd-claims-backend-url>",
  // ONE_WSO2_CC_EXPENSES_BACKEND_URL: "<your-cc-expenses-backend-url>",
  // ONE_WSO2_EXPENSE_CLAIMS_BACKEND_URL: "<your-expense-claims-backend-url>",

  // leave-app frontend base URL (not its backend) — used to deep-link into
  // flows this webapp doesn't replicate (e.g. sabbatical requests).
  // Optional — when absent, that link is hidden.
  // ONE_WSO2_LEAVE_WEB_APP_URL: "<your-leave-app-frontend-url>",
};
